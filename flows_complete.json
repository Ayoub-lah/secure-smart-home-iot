  {
    "id": "func_detection_anomalie",
    "type": "function",
    "z": "tab_smarthome",
    "name": "🔍 Détection Anomalie (règles)",
    "func": "var data;\ntry { data = JSON.parse(msg.payload); } catch(e) { return null; }\n\nvar alerte = null;\nvar niveau = \"INFO\";\n\nif (data.capteur === \"temperature\" && data.valeur > 38) {\n    alerte = \"🌡 ALERTE: Température anormale = \" + data.valeur + \"°C\";\n    niveau = \"DANGER\";\n}\nif (data.capteur === \"fumee\" && data.valeur === 1) {\n    alerte = \"🔥 ALERTE CRITIQUE: Fumée détectée !\";\n    niveau = \"CRITIQUE\";\n}\nif (data.capteur === \"porte\" && data.valeur === 1) {\n    alerte = \"🚪 ATTENTION: Porte ouverte détectée\";\n    niveau = \"WARNING\";\n}\nif (data.capteur === \"mouvement\" && data.valeur === 1) {\n    alerte = \"🚶 NOTICE: Mouvement détecté\";\n    niveau = \"INFO\";\n}\n\nif (alerte) {\n    msg.payload = \"[\" + niveau + \"] \" + alerte + \" | \" + new Date().toLocaleTimeString();\n    return msg;\n}\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "x": 480,
    "y": 480,
    "wires": [
      [
        "text_alertes",
        "debug_alertes"
      ]
    ]
  },
