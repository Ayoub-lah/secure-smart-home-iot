  {
    "id": "func_temperature",
    "type": "function",
    "z": "tab_smarthome",
    "name": "🌡 Capteur Température",
    "func": "var temp = parseFloat((18 + Math.random() * 20).toFixed(1));\nvar normal_min = 15;\nvar normal_max = 35;\nvar is_anomaly = (temp > normal_max || temp < normal_min);\n\nmsg.payload = JSON.stringify({\n    capteur: \"temperature\",\n    valeur: temp,\n    unite: \"°C\",\n    anomalie: is_anomaly,\n    timestamp: new Date().toISOString()\n});\nmsg.topic = \"smarthome/temperature\";\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 60,
    "wires": [
      [
        "mqtt_pub_temp",
        "parse_temp"
      ]
    ]
  },
