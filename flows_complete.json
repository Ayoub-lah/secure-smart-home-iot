  {
    "id": "func_collect_ia4",
    "type": "function",
    "z": "tab_smarthome",
    "name": "🔧 Collecter capteurs",
    "func": "var store = flow.get('capteurs4') || {\n    temperature: 22,\n    mouvement: 0,\n    porte: 0,\n    fumee: 0\n};\n\nvar data;\ntry {\n    data = JSON.parse(msg.payload);\n} catch(e) {\n    return null;\n}\n\nif (data.capteur) {\n    store[data.capteur] = data.valeur;\n    flow.set('capteurs4', store);\n}\n\nvar lastSent = flow.get('lastSent4') || 0;\nvar now = Date.now();\n\nif (now - lastSent > 15000) {\n    flow.set('lastSent4', now);\n    msg.payload = JSON.stringify(store);\n    return msg;\n}\n\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "x": 540,
    "y": 1600,
    "wires": [
      [
        "func_build_cmd"
      ]
    ]
  },
  {
    "id": "func_build_cmd",
    "type": "function",
