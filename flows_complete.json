  {
    "id": "func_firebase_http",
    "type": "function",
    "z": "tab_smarthome",
    "name": "🔧 Préparer requête Firebase",
    "func": "var data;\ntry { data = JSON.parse(msg.payload); } catch(e) { return null; }\n\nvar capteur = data.capteur || \"unknown\";\n\nmsg.url = \"https://smarthomeiot-fd84c-default-rtdb.europe-west1.firebasedatabase.app/smarthome/\" + capteur + \".json\";\nmsg.method = \"POST\";\nmsg.headers = { \"Content-Type\": \"application/json\" };\nmsg.payload = JSON.stringify({\n    valeur: data.valeur,\n    timestamp: data.timestamp,\n    anomalie: data.anomalie || false\n});\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 560,
    "y": 760,
    "wires": [
